# Copie para agente/.env e preencha (Supabase → Project Settings → API).
# A service_role dá acesso total ao banco: mantenha só no seu computador.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram (opcional). Só preencha se a captura de perfil vier com
# "O Instagram exigiu login" — o que é comum quando o agente roda em VPS.
# É o cookie de uma conta SUA já logada no navegador, não a senha.
# Como pegar: no Chrome logado, F12 → Application → Cookies →
# https://www.instagram.com → copie o valor de "sessionid" (e de "ds_user_id").
# Use uma conta secundária, e troque o valor quando expirar.
INSTAGRAM_SESSIONID=
INSTAGRAM_DS_USER_ID=
