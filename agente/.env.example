# Copie para agente/.env e preencha.
# Os dois valores estão no painel, em Prospecção › Meu agente.
PAGINAPRO_URL=
PAGINAPRO_TOKEN=

# Nome que aparece no painel (opcional — padrão: nome do computador).
AGENTE_NOME=

# Instagram (opcional). Só preencha se a captura de perfil vier com
# "O Instagram exigiu login" — o que é comum quando o agente roda em VPS.
# É o cookie de uma conta SUA já logada no navegador, não a senha.
# Como pegar: no Chrome logado, F12 → Application → Cookies →
# https://www.instagram.com → copie o valor de "sessionid" (e de "ds_user_id").
# Use uma conta secundária, e troque o valor quando expirar.
INSTAGRAM_SESSIONID=
INSTAGRAM_DS_USER_ID=

# Ajustes finos (opcionais)
# AGENTE_PAUSA_MS=2500      pausa entre empresas
# AGENTE_INTERVALO_MS=8000  de quanto em quanto tempo checa a fila
# AGENTE_HEADLESS=false     mostra o navegador trabalhando
