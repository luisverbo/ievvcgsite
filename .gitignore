# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agente local (roda na maquina do dono)
agente/node_modules
agente/.env
agente/.perfil-navegador
# A sessão do WhatsApp: quem tem esta pasta ENTRA no WhatsApp do dono.
# Nunca pode subir para o repositório, nem por acidente num `git add -A`.
agente/.perfil-whatsapp
agente/diagnostico
# lixo de build que o Next deixa quando alguém roda na pasta errada
agente/.next

# gerado no build (scripts/gerar-pacote-agente.mjs)
lib/agente/pacote.ts
