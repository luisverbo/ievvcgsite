NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Domínio raiz onde os sites publicam (ex.: paginapro.com.br).
# Sem ele, os sites respondem só em /s/{slug} (bom para testes).
NEXT_PUBLIC_ROOT_DOMAIN=

# Segredo que cifra as chaves de API dos clientes antes de gravar no banco.
# Mínimo 32 caracteres, gerado ao acaso: openssl rand -base64 48
# NUNCA guarde este valor no Supabase — é justamente o que protege um vazamento
# do banco. Trocar este valor invalida todas as chaves já salvas pelos clientes.
APP_CRYPTO_KEY=

# Endereço público do painel, usado no retorno do checkout.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Stripe — assinatura no cartão (a recorrência) e compra de crédito no cartão
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Painel da Stripe → Products → crie o produto de R$300/mês → copie o id do
# preço (começa com price_).
STRIPE_PRICE_AGENCIA=
# Produto do plano Pro (R$97/mês) — mesmo caminho: crie o produto com preço
# recorrente mensal e cole aqui o id do PREÇO (price_...).
STRIPE_PRICE_PRO=
# Preço RECORRENTE de um site extra hospedado (R$29,90/mês). Crie na Stripe um
# produto "Site extra hospedado" com preço mensal e marque "Quantidade" como
# permitida — o sistema soma quantos sites extras o cliente tem no mesmo item
# da assinatura dele. Copie aqui o id do PREÇO (price_...).
STRIPE_PRICE_SITE_EXTRA=
# Painel da Stripe → Developers → Webhooks → endpoint /api/pagamentos/stripe
# Eventos: invoice.paid, invoice.payment_failed, checkout.session.completed,
# customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Valor da mensalidade em centavos. Precisa bater com o preço criado na
# Stripe — este aqui é só o que a tela mostra e o que o Pix avulso cobra.
# Agência (R$300 = 30000) e Pro (R$97 = 9700).
PRECO_MENSAL_CENTAVOS=30000
PRECO_PRO_CENTAVOS=9700

# ---------------------------------------------------------------------------
# Mercado Pago — Pix (crédito avulso e o mês em que o cartão recusou)
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
# Painel do Mercado Pago → Suas integrações → Webhooks → assinatura secreta.
# Notificação em /api/pagamentos/mercadopago, evento "payment".
MERCADOPAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Vercel — domínio próprio dos clientes (etapa de hospedagem)
# ---------------------------------------------------------------------------
# Nomes sem o prefixo VERCEL_ de propósito: a Vercel reserva esse prefixo e
# recusa variáveis criadas com ele.
# Crie em vercel.com → Settings (da conta) → Tokens. Escopo: o projeto do site.
TOKEN_VERCEL=
# Vercel → seu projeto → Settings → General → Project ID (começa com prj_).
PROJETO_VERCEL=
# Só se o projeto estiver dentro de um time (Settings → General → Team ID).
TIME_VERCEL=
