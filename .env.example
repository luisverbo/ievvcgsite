NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Domínio raiz onde os sites publicam (ex.: paginapro.com.br).
# Sem ele, os sites respondem só em /s/{slug} (bom para testes).
NEXT_PUBLIC_ROOT_DOMAIN=

# Segredo que cifra as chaves de API dos clientes antes de gravar no banco.
# Mínimo 32 caracteres, gerado ao acaso: openssl rand -base64 48
# NUNCA guarde este valor no Supabase — é justamente o que protege um vazamento
# do banco. Trocar este valor invalida todas as chaves já salvas pelos clientes.
APP_CRYPTO_KEY=
